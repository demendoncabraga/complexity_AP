import PaperFormalization.Basic

namespace PaperFormalization

/-- The real ℓ₁ space over an index type. -/
abbrev L1 (ι : Type*) := lp (fun _ : ι => ℝ) 1

/-- A uniformly bounded family of vectors defines an operator on ℓ₁. -/
noncomputable def l1Operator {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] (v : ι → E) {C : ℝ} (hC : 0 ≤ C) (hv : ∀ i, ‖v i‖ ≤ C) :
    L1 ι →L[ℝ] E :=
  (lp.tsumCLM ℝ ι E).comp
    (lp.mapCLM 1 (fun i => (ContinuousLinearMap.id ℝ ℝ).smulRight (v i)) hC
      (fun i => ContinuousLinearMap.opNorm_le_bound _ hC (fun a => by
        simpa [norm_smul, mul_comm] using mul_le_mul_of_nonneg_left (hv i) (norm_nonneg a))))

theorem l1Operator_norm_le {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] (v : ι → E) {C : ℝ} (hC : 0 ≤ C) (hv : ∀ i, ‖v i‖ ≤ C) :
    ‖l1Operator v hC hv‖ ≤ C := by
  apply ContinuousLinearMap.opNorm_le_bound _ hC
  exact fun x =>
    (lp.norm_tsum_le _).trans
      ((ContinuousLinearMap.le_opNorm _ x).trans
        (mul_le_mul_of_nonneg_right (lp.norm_mapCLM_le _ _ _ _) (norm_nonneg x)))

@[simp] theorem l1Operator_single {ι E : Type*} [DecidableEq ι] [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (v : ι → E) {C : ℝ} (hC : 0 ≤ C)
    (hv : ∀ i, ‖v i‖ ≤ C) (i : ι) (a : ℝ) :
    l1Operator v hC hv (lp.single 1 i a) = a • v i := by
  change (∑' j, (lp.single (E := fun _ : ι => ℝ) 1 i a) j • v j) = a • v i
  exact (tsum_eq_single i (fun j hj => by rw [lp.single_apply_ne _ _ _ hj, zero_smul])).trans
    (by rw [lp.single_apply_self])

/-- The canonical inclusion along a branch, indexed by prefix length. -/
noncomputable def branchInclusion (b : ℕ → ℕ) : L1 ℕ →L[ℝ] L1 (List ℕ) :=
  l1Operator (C := 1) (fun n => lp.single 1 (List.ofFn fun i : Fin n => b i) 1) (by norm_num)
    (fun n => by simp [lp.norm_single])

/-- The map sending every coordinate to the coordinate of its length. -/
noncomputable def collapseToDepth : L1 (List ℕ) →L[ℝ] L1 ℕ :=
  l1Operator (C := 1) (fun s => lp.single 1 s.length 1) (by norm_num)
    (fun s => by simp [lp.norm_single])

theorem norm_branchInclusion_le (b : ℕ → ℕ) : ‖branchInclusion b‖ ≤ 1 :=
  l1Operator_norm_le _ _ _

theorem norm_collapseToDepth_le : ‖collapseToDepth‖ ≤ 1 :=
  l1Operator_norm_le _ _ _

theorem collapseToDepth_branchInclusion (b : ℕ → ℕ) (x : L1 ℕ) :
    collapseToDepth (branchInclusion b x) = x := by
  have h := (collapseToDepth.comp (branchInclusion b)).hasSum
    (lp.hasSum_single (by norm_num : (1 : ENNReal) ≠ ⊤) x)
  exact (by
    simpa [branchInclusion, collapseToDepth, ← lp.single_smul] using h :
    HasSum (fun n => lp.single 1 n (x n)) (collapseToDepth (branchInclusion b x))).unique
      (lp.hasSum_single (by norm_num) x)

/-- The closed span of the images of the branch kernels. -/
noncomputable def branchKernelSpan {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (P : L1 ℕ →L[ℝ] E) : Submodule ℝ (L1 (List ℕ)) :=
  (⨆ b : ℕ → ℕ, P.toLinearMap.ker.map (branchInclusion b).toLinearMap).topologicalClosure

instance isClosed_branchKernelSpan {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (P : L1 ℕ →L[ℝ] E) : IsClosed (branchKernelSpan P : Set (L1 (List ℕ))) :=
  Submodule.isClosed_topologicalClosure _

/-- The ambient quotient of the tree construction. -/
abbrev TreeQuotient {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (P : L1 ℕ →L[ℝ] E) := L1 (List ℕ) ⧸ branchKernelSpan P

/-- The closed subspace of the ambient quotient generated by the nodes of a tree. -/
noncomputable def treeSpace {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (P : L1 ℕ →L[ℝ] E) (T : NatTree) : Submodule ℝ (TreeQuotient P) :=
  (Submodule.span ℝ ((fun s => (branchKernelSpan P).mkQ (lp.single 1 s 1)) ''
    T.val)).topologicalClosure

/-- Coordinate functions supported on a given tree. -/
def supportedL1 (T : NatTree) : Submodule ℝ (L1 (List ℕ)) where
  carrier := {x | ∀ s ∉ T.val, x s = 0}
  zero_mem' := fun _ _ => rfl
  add_mem' := fun hx hy s hs => by
    change _ + _ = (0 : ℝ)
    rw [hx s hs, hy s hs, add_zero]
  smul_mem' := fun c x hx s hs => by
    change c * x s = 0
    rw [hx s hs, mul_zero]

theorem treeSpace_eq_closure_image {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (P : L1 ℕ →L[ℝ] E) (T : NatTree) :
    treeSpace P T = ((supportedL1 T).map (branchKernelSpan P).mkQ).topologicalClosure := by
  apply le_antisymm
  · exact Submodule.topologicalClosure_mono (Submodule.span_le.mpr fun y hy => by
      obtain ⟨s, hs, rfl⟩ := hy
      exact Submodule.mem_map.mpr ⟨lp.single 1 s 1,
        fun t ht => lp.single_apply_ne _ _ _ (ne_of_mem_of_not_mem hs ht).symm, rfl⟩)
  · refine Submodule.topologicalClosure_minimal _ ?_ (Submodule.isClosed_topologicalClosure _)
    intro y hy
    obtain ⟨x, hx, rfl⟩ := Submodule.mem_map.mp hy
    exact (Submodule.isClosed_topologicalClosure _).mem_of_tendsto
      ((branchKernelSpan P).mkQL.hasSum
        (lp.hasSum_single (by norm_num : (1 : ENNReal) ≠ ⊤) x))
      (Filter.Eventually.of_forall fun f => Submodule.sum_mem _ fun s _ => by
        by_cases hs : s ∈ T.val
        · have he : lp.single 1 s (x s) = x s • lp.single (E := fun _ : List ℕ => ℝ) 1 s 1 := by
            simpa only [smul_eq_mul, mul_one] using lp.single_smul (E := fun _ : List ℕ => ℝ) 1 s (x s) 1
          rw [he, map_smul]
          exact Submodule.smul_mem _ _
            (Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨s, hs, rfl⟩))
        · rw [show x s = 0 from hx s hs, lp.single_zero, map_zero]
          exact Submodule.zero_mem _)

/-- The preimage of the tree space is the closure of ℓ₁(T) + Z. -/
theorem comap_treeSpace {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (P : L1 ℕ →L[ℝ] E) (T : NatTree) :
    (treeSpace P T).comap (branchKernelSpan P).mkQ =
      (branchKernelSpan P ⊔ supportedL1 T).topologicalClosure := by
  rw [treeSpace_eq_closure_image, ← Submodule.comap_map_mkQ (branchKernelSpan P) (supportedL1 T)]
  apply SetLike.coe_injective
  exact (branchKernelSpan P).isOpenMap_mkQ.preimage_closure_eq_closure_preimage
    (branchKernelSpan P).continuous_mkQ
    (((supportedL1 T).map (branchKernelSpan P).mkQ : Submodule ℝ (TreeQuotient P)) : Set _)

theorem norm_liftQL_apply_le {A B : Type*} [NormedAddCommGroup A] [NormedSpace ℝ A]
    [SeminormedAddCommGroup B] [NormedSpace ℝ B] (S : Submodule ℝ A) (f : A →L[ℝ] B)
    (h : S ≤ f.toLinearMap.ker) (hf : ∀ a, ‖f a‖ ≤ ‖a‖) (q : A ⧸ S) :
    ‖S.liftQL f h q‖ ≤ ‖q‖ :=
  le_of_forall_pos_le_add fun ε hε => by
    obtain ⟨a, rfl, ha⟩ := Submodule.Quotient.norm_mk_lt q hε
    exact (hf a).trans ha.le

/-- A subspace of a quotient has the quotient norm on its full preimage. -/
noncomputable def quotientPreimageIsometry {A : Type*} [NormedAddCommGroup A] [NormedSpace ℝ A]
    (Z : Submodule ℝ A) [IsClosed (Z : Set A)] (W : Submodule ℝ (A ⧸ Z)) :
    ((W.comap Z.mkQ) ⧸ Z.comap (W.comap Z.mkQ).subtype) ≃ₗᵢ[ℝ] W := by
  let U := W.comap Z.mkQ
  let ZU := Z.comap U.subtype
  let f : U →L[ℝ] W := (Z.mkQL.comp U.subtypeL).codRestrict W fun x => x.property
  let g : (U ⧸ ZU) →L[ℝ] W :=
    ZU.liftQL f fun x hx => Subtype.ext ((Submodule.Quotient.mk_eq_zero Z).mpr hx)
  have hinj : Function.Injective g := fun q q' h => by
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective ZU q
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective ZU q'
    exact (Submodule.Quotient.eq ZU).mpr
      ((Submodule.Quotient.eq Z).mp (congrArg Subtype.val h))
  have hsurj : Function.Surjective g := fun y =>
    (Submodule.Quotient.mk_surjective Z y.val).elim fun x hx =>
      ⟨Submodule.Quotient.mk (⟨x, show (Submodule.Quotient.mk x : A ⧸ Z) ∈ W from
        hx.symm ▸ y.property⟩ : U), Subtype.ext hx⟩
  refine ⟨LinearEquiv.ofBijective g.toLinearMap ⟨hinj, hsurj⟩, fun q => le_antisymm ?_ ?_⟩
  · exact le_of_forall_pos_le_add fun ε hε => by
      obtain ⟨x, rfl, hx⟩ := Submodule.Quotient.norm_mk_lt q hε
      change ‖(Submodule.Quotient.mk x.val : A ⧸ Z)‖ ≤ ‖Submodule.Quotient.mk (p := ZU) x‖ + ε
      exact (Submodule.Quotient.norm_mk_le Z x.val).trans hx.le
  · exact le_of_forall_pos_le_add fun ε hε => by
      obtain ⟨x, hx, hxNorm⟩ := Submodule.Quotient.norm_mk_lt (g q).val hε
      let xU : U := ⟨x, show (Submodule.Quotient.mk x : A ⧸ Z) ∈ W from
        hx.symm ▸ (g q).property⟩
      have hxq : (Submodule.Quotient.mk xU : U ⧸ ZU) = q := hinj (Subtype.ext hx)
      calc
        ‖q‖ = ‖(Submodule.Quotient.mk xU : U ⧸ ZU)‖ := congrArg norm hxq.symm
        _ ≤ ‖x‖ := Submodule.Quotient.norm_mk_le ZU xU
        _ ≤ _ := hxNorm.le

/-- A contractive linear section with a contractive left inverse is isometric. -/
theorem IsometricOneComplementablyEmbeds.of_contractive_retract {A B : Type*}
    [NormedAddCommGroup A] [NormedSpace ℝ A] [NormedAddCommGroup B] [NormedSpace ℝ B]
    (j : A →L[ℝ] B) (r : B →L[ℝ] A)
    (hj : ∀ q, ‖j q‖ ≤ ‖q‖) (hr : ∀ y, ‖r y‖ ≤ ‖y‖)
    (hleft : Function.LeftInverse r j) : IsometricOneComplementablyEmbeds A B :=
  ⟨⟨j.toLinearMap, fun q => le_antisymm (hj q) (calc
      ‖q‖ = ‖r (j q)‖ := congrArg norm (hleft q).symm
      _ ≤ ‖j q‖ := hr (j q))⟩, r,
    r.opNorm_le_bound zero_le_one (fun y => by simpa only [one_mul] using hr y), hleft⟩

/-- Transport a complemented isometric embedding across a linear isometry equivalence. -/
theorem IsometricOneComplementablyEmbeds.of_isometryEquiv {A B C : Type*}
    [NormedAddCommGroup A] [NormedSpace ℝ A] [NormedAddCommGroup B] [NormedSpace ℝ B]
    [NormedAddCommGroup C] [NormedSpace ℝ C] (e : A ≃ₗᵢ[ℝ] B)
    (h : IsometricOneComplementablyEmbeds A C) : IsometricOneComplementablyEmbeds B C := by
  obtain ⟨i, r, hr, hri⟩ := h
  exact IsometricOneComplementablyEmbeds.of_contractive_retract
    (i.toContinuousLinearMap.comp e.symm.toLinearIsometry.toContinuousLinearMap)
    (e.toLinearIsometry.toContinuousLinearMap.comp r)
    (fun x => le_of_eq (by simp))
    (fun x => by simpa using r.le_of_opNorm_le hr x)
    (fun x => by simpa using congrArg e (hri (e.symm x)))

section BranchQuotient

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
variable (P : L1 ℕ →L[ℝ] E)

theorem branchKernelSpan_le_depthKernel :
    branchKernelSpan P ≤ (P.comp collapseToDepth).toLinearMap.ker :=
  Submodule.topologicalClosure_minimal _ (iSup_le fun b _ hx => by
    obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.mp hx
    simpa [LinearMap.mem_ker, collapseToDepth_branchInclusion] using hy)
    (P.comp collapseToDepth).isClosed_ker

theorem branchInclusion_maps_ker (b : ℕ → ℕ) :
    P.toLinearMap.ker ≤
      ((branchKernelSpan P).mkQL.comp (branchInclusion b)).toLinearMap.ker :=
  fun x hx => (Submodule.Quotient.mk_eq_zero _).mpr
    (Submodule.le_topologicalClosure _ (le_iSup
      (fun b : ℕ → ℕ => P.toLinearMap.ker.map (branchInclusion b).toLinearMap) b
        (Submodule.mem_map.mpr ⟨x, hx, rfl⟩)))

theorem branchInclusion_mem_treeSpace (T : NatTree) (b : ℕ → ℕ)
    (hb : b ∈ T.branches) (x : L1 ℕ) :
    (branchKernelSpan P).mkQL (branchInclusion b x) ∈ treeSpace P T := by
  have h := ((branchKernelSpan P).mkQL.comp (branchInclusion b)).hasSum
    (lp.hasSum_single (by norm_num : (1 : ENNReal) ≠ ⊤) x)
  exact (Submodule.isClosed_topologicalClosure _).mem_of_tendsto h
    (Filter.Eventually.of_forall fun f => Submodule.sum_mem _ fun n _ => by
      simp only [ContinuousLinearMap.comp_apply, branchInclusion, l1Operator_single, map_smul]
      exact Submodule.smul_mem _ _
        (Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨_, hb n, rfl⟩)))

instance isClosed_l1Kernel : IsClosed (P.toLinearMap.ker : Set (L1 ℕ)) := P.isClosed_ker

/-- A branch produces a contractively complemented isometric copy of the operator quotient. -/
theorem branchQuotient_complementablyEmbeds (T : NatTree) (b : ℕ → ℕ)
    (hb : b ∈ T.branches) :
    IsometricOneComplementablyEmbeds (L1 ℕ ⧸ P.toLinearMap.ker) (treeSpace P T) := by
  let i := ((branchKernelSpan P).mkQL.comp (branchInclusion b)).codRestrict
    (treeSpace P T) (branchInclusion_mem_treeSpace P T b hb)
  have hi : P.toLinearMap.ker ≤ i.toLinearMap.ker :=
    fun x hx => Subtype.ext (branchInclusion_maps_ker P b hx)
  let j : (L1 ℕ ⧸ P.toLinearMap.ker) →L[ℝ] treeSpace P T := P.toLinearMap.ker.liftQL i hi
  let d := P.toLinearMap.ker.mkQL.comp collapseToDepth
  have hd : branchKernelSpan P ≤ d.toLinearMap.ker :=
    fun x hx => (Submodule.Quotient.mk_eq_zero _).mpr (branchKernelSpan_le_depthKernel P hx)
  let r : treeSpace P T →L[ℝ] (L1 ℕ ⧸ P.toLinearMap.ker) :=
    ((branchKernelSpan P).liftQL d hd).comp (treeSpace P T).subtypeL
  have hr : ∀ y, ‖r y‖ ≤ ‖y‖ := fun y => norm_liftQL_apply_le _ d hd
    (fun x => (Submodule.Quotient.norm_mk_le _ _).trans
      (by simpa using collapseToDepth.le_of_opNorm_le norm_collapseToDepth_le x)) y.val
  have hiNorm (x : L1 ℕ) : ‖i x‖ ≤ ‖x‖ := by
    change ‖(Submodule.Quotient.mk (branchInclusion b x) : TreeQuotient P)‖ ≤ ‖x‖
    exact (Submodule.Quotient.norm_mk_le (branchKernelSpan P) _).trans
      (by simpa using (branchInclusion b).le_of_opNorm_le (norm_branchInclusion_le b) x)
  have hj (q : L1 ℕ ⧸ P.toLinearMap.ker) : ‖j q‖ ≤ ‖q‖ :=
    le_of_forall_pos_le_add fun ε hε => by
      obtain ⟨x, rfl, hx⟩ := Submodule.Quotient.norm_mk_lt q hε
      exact (hiNorm x).trans hx.le
  have hleft : Function.LeftInverse r j := fun q => by
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    change Submodule.Quotient.mk (collapseToDepth (branchInclusion b x)) =
      (Submodule.Quotient.mk x : L1 ℕ ⧸ P.toLinearMap.ker)
    rw [collapseToDepth_branchInclusion]
  exact IsometricOneComplementablyEmbeds.of_contractive_retract j r hj hr hleft

/-- The ill-founded case of the reduction, for a surjective isometric quotient operator. -/
theorem illFounded_isometricOneComplementablyEmbeds [CompleteSpace E] [TopologicalSpace.SeparableSpace E]
    (T : NatTree) (hT : T.IsIllFounded)
    (hP : Function.Surjective P)
    (hIso : Isometry (P.toLinearMap.ker.liftQL P le_rfl)) :
    IsometricOneComplementablyEmbeds E (treeSpace P T) := by
  obtain ⟨b, hb⟩ := hT
  let e := LinearIsometryEquiv.ofSurjective
    ((P.toLinearMap.ker.liftQL P le_rfl).toLinearMap.toLinearIsometry hIso)
    (fun y => (hP y).elim fun x hx => ⟨Submodule.Quotient.mk x, hx⟩)
  exact IsometricOneComplementablyEmbeds.of_isometryEquiv e
    (branchQuotient_complementablyEmbeds P T b hb)

end BranchQuotient
end PaperFormalization
