import PaperFormalization.TreeReduction

namespace PaperFormalization

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The line generated by the image of the root node in the ambient quotient. -/
noncomputable def treeRootLine (P : L1 ℕ →L[ℝ] E) : Submodule ℝ (TreeQuotient P) :=
  Submodule.span ℝ {(branchKernelSpan P).mkQ (lp.single 1 [] 1)}

instance isClosed_treeRootLine (P : L1 ℕ →L[ℝ] E) :
    IsClosed (treeRootLine P : Set (TreeQuotient P)) := by
  unfold treeRootLine
  exact Submodule.closed_of_finiteDimensional _

theorem treeRootLine_le_treeSpace (P : L1 ℕ →L[ℝ] E) (T : NatTree)
    (hroot : [] ∈ T.val) : treeRootLine P ≤ treeSpace P T :=
  Submodule.span_le.mpr fun x hx => by
    have he : x = (branchKernelSpan P).mkQ (lp.single 1 [] 1) := hx
    subst x
    exact Submodule.le_topologicalClosure _
      (Submodule.subset_span ⟨[], hroot, rfl⟩)

theorem treeSpace_le_rootLine (P : L1 ℕ →L[ℝ] E) (T : NatTree)
    (hT : T.val ⊆ {[]}) : treeSpace P T ≤ treeRootLine P := by
  apply Submodule.topologicalClosure_minimal
  · exact Submodule.span_le.mpr fun x hx => by
      obtain ⟨s, hs, rfl⟩ := hx
      have he : s = [] := hT hs
      subst s
      exact Submodule.mem_span_singleton_self _
  · unfold treeRootLine
    exact Submodule.closed_of_finiteDimensional _

/-- The empty tree and the tree containing only its root yield spaces of dimension at most one. -/
theorem treeSpace_finiteDimensional_of_root_only (P : L1 ℕ →L[ℝ] E) (T : NatTree)
    (hT : T.val ⊆ {[]}) :
    FiniteDimensional ℝ (treeSpace P T) ∧ Module.finrank ℝ (treeSpace P T) ≤ 1 := by
  let _ : FiniteDimensional ℝ (treeRootLine P) := by unfold treeRootLine; infer_instance
  have hle := treeSpace_le_rootLine P T hT
  exact ⟨FiniteDimensional.of_injective (Submodule.inclusion hle) (Submodule.inclusion_injective _),
    (Submodule.finrank_mono hle).trans (by
      let r := (branchKernelSpan P).mkQ (lp.single 1 [] 1)
      change Module.finrank ℝ (Submodule.span ℝ {r}) ≤ 1
      by_cases hr : r = 0
      · rw [hr, Submodule.span_zero_singleton, finrank_bot]; decide
      · exact (finrank_span_singleton (K := ℝ) hr).le)⟩

end PaperFormalization
