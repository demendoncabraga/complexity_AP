import PaperFormalization.TreeReduction
import PaperFormalization.TreeInduction

namespace PaperFormalization

open scoped ENNReal

/-- Continuous linear maps on ℓ₁ are determined by the unit coordinate vectors. -/
theorem l1Operator_ext {ι E : Type*} [DecidableEq ι] [NormedAddCommGroup E] [NormedSpace ℝ E]
    {f g : L1 ι →L[ℝ] E} (h : ∀ i, f (lp.single 1 i 1) = g (lp.single 1 i 1)) :
    f = g := by
  ext x
  have hx := lp.hasSum_single (by simp : (1 : ℝ≥0∞) ≠ ⊤) x
  have he (i : ι) : f (lp.single 1 i (x i)) = g (lp.single 1 i (x i)) := by
    have hs : lp.single 1 i (x i) = x i • lp.single (E := fun _ : ι => ℝ) 1 i 1 := by
      simpa only [smul_eq_mul, mul_one] using lp.single_smul (E := fun _ : ι => ℝ) 1 i (x i) 1
    rw [hs, map_smul, map_smul, h i]
  exact (f.hasSum hx).unique (by simpa only [he] using g.hasSum hx)

/-- Push coordinates forward along a partial map, discarding those mapped to none. -/
noncomputable def l1Push {ι κ : Type*} [DecidableEq κ] (f : ι → Option κ) :
    L1 ι →L[ℝ] L1 κ :=
  l1Operator (C := 1) (fun i => (f i).elim 0 (fun k => lp.single 1 k 1)) zero_le_one
    (fun i => by cases f i <;> simp [lp.norm_single])

@[simp] theorem l1Push_single {ι κ : Type*} [DecidableEq ι] [DecidableEq κ]
    (f : ι → Option κ) (i : ι) (a : ℝ) :
    l1Push f (lp.single 1 i a) = (f i).elim 0 (fun k => lp.single 1 k a) := by
  unfold l1Push
  rw [l1Operator_single]
  cases f i <;> simp [← lp.single_smul]

theorem norm_l1Push_le {ι κ : Type*} [DecidableEq κ] (f : ι → Option κ) :
    ‖l1Push f‖ ≤ 1 :=
  l1Operator_norm_le _ _ _

/-- Shift the coordinates of ℓ₁ by one, leaving the zeroth coordinate zero. -/
noncomputable def shiftL1 : L1 ℕ →L[ℝ] L1 ℕ :=
  l1Push fun n => some (n + 1)

/-- Delete the zeroth coordinate of ℓ₁. -/
noncomputable def dropFirstL1 : L1 ℕ →L[ℝ] L1 ℕ :=
  l1Push fun
    | 0 => none
    | n + 1 => some n

/-- Embed coordinates as the nodes beginning with m. -/
noncomputable def prependL1 (m : ℕ) : L1 (List ℕ) →L[ℝ] L1 (List ℕ) :=
  l1Push fun s => some (m :: s)

/-- Retain nodes beginning with m and remove that initial symbol. -/
noncomputable def successorL1 (m : ℕ) : L1 (List ℕ) →L[ℝ] L1 (List ℕ) :=
  l1Push fun
    | [] => none
    | n :: s => if n = m then some s else none

@[simp] theorem dropFirstL1_shiftL1 (x : L1 ℕ) : dropFirstL1 (shiftL1 x) = x :=
  DFunLike.congr_fun (show dropFirstL1.comp shiftL1 = ContinuousLinearMap.id ℝ (L1 ℕ) from
    l1Operator_ext fun n => by simp [dropFirstL1, shiftL1]) x

@[simp] theorem successorL1_prependL1 (m : ℕ) (x : L1 (List ℕ)) :
    successorL1 m (prependL1 m x) = x :=
  DFunLike.congr_fun
    (show (successorL1 m).comp (prependL1 m) = ContinuousLinearMap.id ℝ (L1 (List ℕ)) from
      l1Operator_ext fun s => by simp [successorL1, prependL1]) x

/-- Prepend one symbol to an infinite branch. -/
def prependBranch (m : ℕ) (b : ℕ → ℕ) : ℕ → ℕ
  | 0 => m
  | n + 1 => b n

theorem successorL1_branchInclusion (m k : ℕ) (b : ℕ → ℕ) :
    (successorL1 m).comp (branchInclusion (prependBranch k b)) =
      if k = m then (branchInclusion b).comp dropFirstL1 else 0 := by
  by_cases h : k = m
  · subst k
    rw [if_pos rfl]
    exact l1Operator_ext fun n => by
      cases n <;>
        simp [branchInclusion, successorL1, dropFirstL1, List.ofFn_succ, prependBranch]
  · rw [if_neg h]
    exact l1Operator_ext fun n => by
      cases n <;>
        simp [branchInclusion, successorL1, h, List.ofFn_succ, prependBranch]

theorem branchInclusion_prepend_shift (m : ℕ) (b : ℕ → ℕ) :
    (branchInclusion (prependBranch m b)).comp shiftL1 = (prependL1 m).comp (branchInclusion b) :=
  l1Operator_ext fun n => by
    simp [branchInclusion, shiftL1, prependL1, List.ofFn_succ, prependBranch]

/-- The line generated by the root vector before passing to the tree quotient. -/
noncomputable def rootCoordinateLine : Submodule ℝ (L1 (List ℕ)) :=
  Submodule.span ℝ {lp.single 1 [] 1}

section Tail

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The line in the target contributed by the root coordinate. -/
noncomputable def rootImage (P : L1 ℕ →L[ℝ] E) : Submodule ℝ E :=
  Submodule.span ℝ {P (lp.single 1 0 1)}

instance isClosed_rootImage (P : L1 ℕ →L[ℝ] E) : IsClosed (rootImage P : Set E) := by
  unfold rootImage
  exact Submodule.closed_of_finiteDimensional _

/-- Shift the input coordinates and quotient the target by the image of the root. -/
noncomputable def tailOperator (P : L1 ℕ →L[ℝ] E) : L1 ℕ →L[ℝ] (E ⧸ rootImage P) :=
  (rootImage P).mkQL.comp (P.comp shiftL1)

theorem tailOperator_comp_dropFirstL1 (P : L1 ℕ →L[ℝ] E) :
    (tailOperator P).comp dropFirstL1 = (rootImage P).mkQL.comp P := by
  apply l1Operator_ext
  intro n
  cases n with
  | zero =>
    simpa [tailOperator, dropFirstL1, Submodule.mkQL_apply] using
      ((Submodule.Quotient.mk_eq_zero (rootImage P)).mpr
        (Submodule.mem_span_singleton_self (P (lp.single 1 0 1)))).symm
  | succ n => simp [tailOperator, dropFirstL1, shiftL1]

/-- Deleting the root coordinate takes the kernel of P onto the kernel of the tail operator. -/
theorem map_dropFirstL1_ker (P : L1 ℕ →L[ℝ] E) :
    P.toLinearMap.ker.map dropFirstL1.toLinearMap = (tailOperator P).toLinearMap.ker := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    have he := DFunLike.congr_fun (tailOperator_comp_dropFirstL1 P) x
    change tailOperator P (dropFirstL1 x) = 0
    change tailOperator P (dropFirstL1 x) = (rootImage P).mkQL (P x) at he
    rw [he, show P x = 0 from hx, map_zero]
  · intro hy
    have hz : (Submodule.Quotient.mk (P (shiftL1 y)) : E ⧸ rootImage P) = 0 := hy
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp
      ((Submodule.Quotient.mk_eq_zero (rootImage P)).mp hz)
    refine ⟨shiftL1 y - a • lp.single 1 0 1, ?_, ?_⟩
    · change P (shiftL1 y - a • lp.single 1 0 1) = 0
      rw [map_sub, map_smul, ha, sub_self]
    · change dropFirstL1 (shiftL1 y - a • lp.single 1 0 1) = y
      rw [map_sub, map_smul, dropFirstL1_shiftL1]
      simp [dropFirstL1]

/-- The successor projection identifies the kernel from the matching branch. -/
theorem map_successorL1_branchKernel (P : L1 ℕ →L[ℝ] E) (m : ℕ) (b : ℕ → ℕ) :
    (P.toLinearMap.ker.map (branchInclusion (prependBranch m b)).toLinearMap).map
        (successorL1 m).toLinearMap =
      (tailOperator P).toLinearMap.ker.map (branchInclusion b).toLinearMap := by
  rw [← Submodule.map_comp]
  change P.toLinearMap.ker.map
    ((successorL1 m).comp (branchInclusion (prependBranch m b))).toLinearMap = _
  rw [successorL1_branchInclusion, if_pos rfl]
  change P.toLinearMap.ker.map ((branchInclusion b).toLinearMap.comp dropFirstL1.toLinearMap) = _
  rw [Submodule.map_comp, map_dropFirstL1_ker]

theorem successorL1_maps_branchKernelSpan (P : L1 ℕ →L[ℝ] E) (m : ℕ) :
    (branchKernelSpan P).map (successorL1 m).toLinearMap ≤ branchKernelSpan (tailOperator P) := by
  unfold branchKernelSpan
  refine (Submodule.topologicalClosure_map _ _).trans ?_
  apply Submodule.topologicalClosure_mono
  rw [Submodule.map_iSup]
  refine iSup_le fun b => ?_
  let tail := fun n : ℕ => b (n + 1)
  have hb : prependBranch (b 0) tail = b := funext fun n => by cases n <;> rfl
  rw [← hb, ← Submodule.map_comp]
  change P.toLinearMap.ker.map
    ((successorL1 m).comp (branchInclusion (prependBranch (b 0) tail))).toLinearMap ≤ _
  rw [successorL1_branchInclusion]
  split
  · change P.toLinearMap.ker.map ((branchInclusion tail).toLinearMap.comp dropFirstL1.toLinearMap) ≤ _
    rw [Submodule.map_comp, map_dropFirstL1_ker]
    exact le_iSup (fun c : ℕ → ℕ => (tailOperator P).toLinearMap.ker.map (branchInclusion c).toLinearMap) tail
  · simp

theorem prependL1_maps_branchKernelSpan (P : L1 ℕ →L[ℝ] E) (m : ℕ) :
    (branchKernelSpan (tailOperator P)).map (prependL1 m).toLinearMap ≤
      branchKernelSpan P ⊔ rootCoordinateLine := by
  apply Submodule.map_le_iff_le_comap.mpr
  unfold branchKernelSpan at ⊢
  refine Submodule.topologicalClosure_minimal _ ?_ ?_
  · refine iSup_le fun b x hx => ?_
    obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.mp hx
    have hz : (Submodule.Quotient.mk (P (shiftL1 y)) : E ⧸ rootImage P) = 0 := hy
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp
      ((Submodule.Quotient.mk_eq_zero (rootImage P)).mp hz)
    let u := shiftL1 y - a • lp.single (E := fun _ : ℕ => ℝ) 1 0 1
    have hu : u ∈ P.toLinearMap.ker := by
      change P (shiftL1 y - a • lp.single 1 0 1) = 0
      rw [map_sub, map_smul, ha, sub_self]
    let v := branchInclusion (prependBranch m b)
    have hv : v u ∈ branchKernelSpan P :=
      Submodule.le_topologicalClosure _
        (le_iSup (fun c : ℕ → ℕ => P.toLinearMap.ker.map (branchInclusion c).toLinearMap)
          (prependBranch m b) (Submodule.mem_map.mpr ⟨u, hu, rfl⟩))
    have hr : a • lp.single (E := fun _ : List ℕ => ℝ) 1 [] 1 ∈ rootCoordinateLine :=
      Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
    have he := DFunLike.congr_fun (branchInclusion_prepend_shift m b) y
    have hfirst : v (lp.single 1 0 1) = lp.single 1 [] 1 := by simp [v, branchInclusion]
    have hsum : v u + a • lp.single 1 [] 1 = prependL1 m (branchInclusion b y) := by
      change v (shiftL1 y - a • lp.single 1 0 1) + a • lp.single 1 [] 1 = _
      rw [map_sub, map_smul, hfirst, sub_add_cancel]
      exact he
    change prependL1 m (branchInclusion b y) ∈ branchKernelSpan P ⊔ rootCoordinateLine
    rw [← hsum]
    exact Submodule.add_mem _ (Submodule.mem_sup_left hv) (Submodule.mem_sup_right hr)
  · change IsClosed ((prependL1 m) ⁻¹' ((branchKernelSpan P ⊔ rootCoordinateLine : Submodule ℝ
      (L1 (List ℕ))) : Set (L1 (List ℕ))))
    let _ : FiniteDimensional ℝ rootCoordinateLine := by unfold rootCoordinateLine; infer_instance
    exact (Submodule.isClosed_sup_finiteDimensional _ _ (isClosed_branchKernelSpan P)).preimage
      (prependL1 m).continuous

theorem map_successorL1_rootCoordinateLine (m : ℕ) :
    rootCoordinateLine.map (successorL1 m).toLinearMap = ⊥ := by
  rw [rootCoordinateLine, Submodule.map_span, Set.image_singleton]
  change Submodule.span ℝ {successorL1 m (lp.single 1 [] 1)} = ⊥
  simp [successorL1, Submodule.span_zero_singleton]

/-- Each successor projection maps the closed common kernel span onto the corresponding tail span. -/
theorem map_successorL1_branchKernelSpan (P : L1 ℕ →L[ℝ] E) (m : ℕ) :
    (branchKernelSpan P).map (successorL1 m).toLinearMap = branchKernelSpan (tailOperator P) := by
  apply le_antisymm (successorL1_maps_branchKernelSpan P m)
  have h := Submodule.map_mono (f := (successorL1 m).toLinearMap)
    (prependL1_maps_branchKernelSpan P m)
  rw [Submodule.map_sup, map_successorL1_rootCoordinateLine, sup_bot_eq, ← Submodule.map_comp] at h
  have he : (successorL1 m).toLinearMap.comp (prependL1 m).toLinearMap =
      LinearMap.id := LinearMap.ext (successorL1_prependL1 m)
  simpa only [he, Submodule.map_id] using h

end Tail
end PaperFormalization
